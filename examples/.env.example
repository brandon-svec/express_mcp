# OAuth provider: github | google
OAUTH_PROVIDER=github

# Base URL of this server (no trailing slash)
BASE_URL=http://localhost:3000

# Register OAuth app and set redirect URI to:
#   http://localhost:3000/auth/callback
# GitHub: Settings > Developer settings > OAuth Apps
# Google: Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_CALLBACK_URL=http://localhost:3000/auth/callback

# Secrets for JWT (MCP sessions) and express-session (OAuth handshake)
JWT_SECRET=change-me-to-a-long-random-string
SESSION_SECRET=change-me-to-another-random-string
JWT_EXPIRES_IN=7d
