# Multi-provider: set both for GitHub + Google on one server
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Legacy single-provider fallback
OAUTH_PROVIDER=github
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

BASE_URL=http://localhost:3000
OAUTH_CALLBACK_URL=http://localhost:3000/mcp/auth/callback

JWT_SECRET=change-me-to-a-long-random-string
SESSION_SECRET=change-me-to-another-random-string
JWT_EXPIRES_IN=7d

# Optional: restrict MCP to these emails or logins (comma-separated)
AUTH_ALLOWED_USERS=your@gmail.com
