{
  "name": "MCP Test Express",
  "description": "express_mcp test server with optional GitHub/Google OAuth",
  "repository": "https://github.com/brandon-svec/express_mcp",
  "keywords": ["node", "express", "mcp"],
  "stack": "heroku-24",
  "formation": {
    "web": {
      "quantity": 1,
      "size": "eco"
    }
  },
  "env": {
    "BASE_URL": {
      "description": "Public URL, e.g. https://mcp-test-express.herokuapp.com",
      "required": false
    },
    "OAUTH_PROVIDER": {
      "description": "github or google",
      "value": "github",
      "required": false
    },
    "OAUTH_CLIENT_ID": {
      "description": "OAuth app client ID",
      "required": false
    },
    "OAUTH_CLIENT_SECRET": {
      "description": "OAuth app client secret",
      "required": false
    },
    "OAUTH_CALLBACK_URL": {
      "description": "OAuth redirect URI, must match provider app settings",
      "required": false
    },
    "JWT_SECRET": {
      "description": "Secret for signing MCP session JWTs",
      "required": false
    },
    "SESSION_SECRET": {
      "description": "Secret for OAuth handshake sessions",
      "required": false
    }
  },
  "scripts": {
    "postdeploy": "echo 'Open /health then /auth/login after setting OAuth config vars'"
  }
}
