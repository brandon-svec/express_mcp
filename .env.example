# Heroku: set these with `heroku config:set KEY=value -a mcp-test-express`

# Public URL (required on Heroku for OAuth callback)
BASE_URL=https://mcp-test-express.herokuapp.com

# Multi-provider OAuth (set both for GitHub + Google login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Legacy single-provider (used if GITHUB_* and GOOGLE_* are not both set)
OAUTH_PROVIDER=github
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

OAUTH_CALLBACK_URL=https://mcp-test-express.herokuapp.com/auth/callback

JWT_SECRET=
SESSION_SECRET=
JWT_EXPIRES_IN=7d

# Optional: comma-separated emails or logins allowed to use MCP (empty = all authenticated users)
AUTH_ALLOWED_USERS=

# Set to false to run MCP without auth
# AUTH_ENABLED=true

# Optional
MCP_SERVER_NAME=mcp-test-express
LOG_LEVEL=info
