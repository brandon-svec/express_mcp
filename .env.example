# Multi-provider: set both for GitHub + Google on one server
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Legacy single-provider fallback
OAUTH_PROVIDER=github
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

BASE_URL=http://localhost:3000
OAUTH_CALLBACK_URL=http://localhost:3000/auth/callback

JWT_SECRET=
SESSION_SECRET=
JWT_EXPIRES_IN=7d

# Optional: comma-separated emails or logins allowed to use MCP (empty = all authenticated users)
AUTH_ALLOWED_USERS=

# Set to false to run MCP without auth
# AUTH_ENABLED=false

LOG_LEVEL=info
