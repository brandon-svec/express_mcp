# Heroku: set these with `heroku config:set KEY=value -a mcp-test-express`

# Public URL (required on Heroku for OAuth callback)
BASE_URL=https://mcp-test-express.herokuapp.com

# OAuth provider: github | google
OAUTH_PROVIDER=github
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_CALLBACK_URL=https://mcp-test-express.herokuapp.com/auth/callback

JWT_SECRET=
SESSION_SECRET=
JWT_EXPIRES_IN=7d

# Set to false to run MCP without auth (not recommended in production)
# AUTH_ENABLED=true

# Optional
MCP_SERVER_NAME=mcp-test-express
LOG_LEVEL=info
